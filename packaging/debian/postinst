#!/bin/sh
set -e

if ! getent group ferrent >/dev/null; then
    addgroup --system ferrent
fi
if ! getent passwd ferrent >/dev/null; then
    adduser --system --ingroup ferrent --home /var/lib/ferrent \
        --no-create-home --shell /usr/sbin/nologin ferrent
fi

install -d -m 0750 -o ferrent -g ferrent /var/lib/ferrent
install -d -m 0755 /etc/ferrent
if [ -f /etc/ferrent/config.toml ]; then
    chown root:ferrent /etc/ferrent/config.toml
    chmod 0640 /etc/ferrent/config.toml
fi

# The token is generated here, never shipped in the package.
if [ ! -s /etc/ferrent/token ]; then
    umask 027
    (head -c 32 /dev/urandom | base64 | tr -d '\n'; echo) > /etc/ferrent/token
    chown root:ferrent /etc/ferrent/token
    chmod 0640 /etc/ferrent/token
fi

if [ -d /run/systemd/system ]; then
    systemctl daemon-reload >/dev/null 2>&1 || true
    deb-systemd-helper enable ferrentd.service >/dev/null 2>&1 || true
fi

exit 0
